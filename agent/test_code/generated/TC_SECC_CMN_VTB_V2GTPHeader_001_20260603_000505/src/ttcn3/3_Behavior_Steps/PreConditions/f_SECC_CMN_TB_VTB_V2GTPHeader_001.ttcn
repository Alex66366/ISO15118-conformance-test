module TestBehavior_V2GTPHeader001 {

    import from SECC_TestSystem all;
    import from SECC_Types all;
    import from SECC_CmnTemplates all;
    import from SECC_Constants all;

    /**
     * @desc    Test behavior for V2GTP header validation (GoodCase)
     *          Sends SupportedAppProtocolReq with valid V2GTP header
     *          (ProtocolVersion=0x01, InverseProtocolVersion=0xFE,
     *          PayloadType=0x8001, accurate PayloadLength)
     *          and verifies SECC accepts and responds correctly.
     * @reference V2G2-082
     */
    function f_SECC_CMN_TB_VTB_V2GTPHeader_001()
        runs on SECCTester
        return verdicttype
    {
        timer tc_V2G_EVCC_Msg_Timer := PX_SECC_CMN_Message_Timeout;

        log("Phase C: Sending SupportedAppProtocolReq with valid V2GTP header...");
        log("V2GTP Header Test: ProtocolVersion=0x01, InverseProtocolVersion=0xFE, PayloadType=0x8001");

        tc_V2G_EVCC_Msg_Timer.start;

        // STEP 3: Send via structured union -- ExiCodecAdapter encodes with valid V2GTP header
        pt_V2G_TCP_TLS_ALM_SECC_Port.send(
            { supportedAppProtocolReq := md_CMN_SupportedAppProtocolReq_001 }
        );

        // STEP 4: Receive and set verdict
        alt {
            [] pt_V2G_TCP_TLS_ALM_SECC_Port.receive(
                { supportedAppProtocolRes := md_CMN_SupportedAppProtocolRes_001 }
            ) {
                tc_V2G_EVCC_Msg_Timer.stop;
                log("SupportedAppProtocolRes received: SECC accepted V2GTP message with valid header");
                setverdict(pass, "SECC correctly processed V2GTP message with valid header");
            }
            [] pt_V2G_TCP_TLS_ALM_SECC_Port.receive(
                { supportedAppProtocolRes := md_CMN_SupportedAppProtocolRes_002 }
            ) {
                tc_V2G_EVCC_Msg_Timer.stop;
                setverdict(fail, "SECC rejected the protocol negotiation");
            }
            [] pt_V2G_TCP_TLS_ALM_SECC_Port.receive {
                tc_V2G_EVCC_Msg_Timer.stop;
                setverdict(fail, "Unexpected message received");
            }
            [] tc_V2G_EVCC_Msg_Timer.timeout {
                setverdict(inconc, "Timeout waiting for SupportedAppProtocolRes");
            }
        }

        return getverdict;
    }

}