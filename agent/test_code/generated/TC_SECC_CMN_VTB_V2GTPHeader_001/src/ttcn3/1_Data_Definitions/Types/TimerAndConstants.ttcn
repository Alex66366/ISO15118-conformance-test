module SECC_Constants {
    import from SECC_TestSystem all;

    // ==========================================
    // Section 1: ISO 15118-2 Message Timeouts (PX_ = PIXIT-level timeouts)
    // ==========================================

    // V2G message exchange timeout
    const float PX_SECC_CMN_Message_Timeout := 60.0;

    // Sequence timeout (for multi-step handshakes)
    const float PX_SECC_CMN_Sequence_Timeout := 2.0;

    // Communication setup timeout (TCP/TLS connection)
    const float PX_SECC_CMN_CommunicationSetup_Timeout := 10.0;

    // TCP connection timeout
    const float PX_SECC_CMN_TCP_Connection_Timeout := 5.0;

    // TLS handshake timeout
    const float PX_SECC_CMN_TLS_Handshake_Timeout := 10.0;

    // SDP discovery response timeout
    const float PX_SECC_CMN_SDP_Response_Timeout := 1.0;

    // ==========================================
    // Section 2: Default Timer Values
    // ==========================================

    const float PX_SECC_CMN_DefaultTimer := 5.0;
    const float PX_SECC_CMN_LongTimer    := 30.0;
    const float PX_SECC_CMN_ShortTimer   := 1.0;

    // ==========================================
    // Section 3: Common Constants
    // ==========================================

    // V2GTP Protocol Version
    const octetstring PX_SECC_CMN_V2GTP_ProtocolVersion := '01'O;
    const octetstring PX_SECC_CMN_V2GTP_InvVersion      := 'FE'O;

    // Default EVCCID for testing (8 bytes)
    const octetstring PX_SECC_CMN_Default_EVCCID := '123456789ABC'O;

    // Default Session ID (all zeros = new session)
    const octetstring PX_SECC_CMN_Default_SessionID := '0000000000000000'O;

    // ==========================================
    // Section 4: V2GTP Header Constants
    // ==========================================

    // V2GTP PayloadType for V2G application messages
    const octetstring PX_SECC_CMN_V2GTP_PayloadType_V2GMsg := '8001'O;

    // V2GTP PayloadType for SDP
    const octetstring PX_SECC_CMN_V2GTP_PayloadType_SDP := '9000'O;

    // ==========================================
    // Section 5: Port and Network Constants
    // ==========================================

    const integer PX_SECC_CMN_TCP_Port := 15118;
    const integer PX_SECC_CMN_UDP_Port := 15118;

} // end of module SECC_Constants
