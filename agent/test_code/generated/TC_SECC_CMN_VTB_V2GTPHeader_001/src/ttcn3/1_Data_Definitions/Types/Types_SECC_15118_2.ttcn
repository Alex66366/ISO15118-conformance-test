module SECC_Types {
    import from SECC_TestSystem all;

    // ==========================================
    // Section 1: EvccID Type
    // ==========================================

    type record EvccIDType {
        // Electric Vehicle Communication Controller ID
        // Max 8 bytes (EVCCID in ISO 15118)
        octetstring  content optional
    }

    // ==========================================
    // Section 2: SessionID Type
    // ==========================================

    type record SessionIDType {
        // Session ID for V2G communication
        // 8 bytes
        octetstring  content optional
    }

    // ==========================================
    // Section 3: Message Type Constants
    // ==========================================

    // V2G message types (16-bit values)
    const integer V2G_MSG_TYPE_SDP_REQUEST        := 36864;  // 0x9000
    const integer V2G_MSG_TYPE_SDP_RESPONSE       := 36865;  // 0x9001
    const integer V2G_MSG_TYPE_SUPPORTED_APP_PROT := 32768;  // 0x8000
    const integer V2G_MSG_TYPE_SESSION_SETUP      := 32769;  // 0x8001
    const integer V2G_MSG_TYPE_SERVICE_DISCOVERY  := 32770;  // 0x8002
    const integer V2G_MSG_TYPE_SERVICE_PAYMENT    := 32771;  // 0x8003
    const integer V2G_MSG_TYPE_CHARGE_PARAMETER   := 32772;  // 0x8004
    const integer V2G_MSG_TYPE_POWER_DELIVERY     := 32773;  // 0x8005
    const integer V2G_MSG_TYPE_SESSION_STOP       := 32774;  // 0x8006
    const integer V2G_MSG_TYPE_CABLE_CHECK        := 32775;  // 0x8007
    const integer V2G_MSG_TYPE_PRE_CHARGE         := 32776;  // 0x8008
    const integer V2G_MSG_TYPE_CURRENT_DEMAND     := 32777;  // 0x8009

    // ==========================================
    // Section 4: V2GTP Header Fields
    // ==========================================

    // V2GTP Protocol Version (1 byte: 0x01)
    const octetstring c_V2GTP_ProtocolVersion     := '01'O;
    // V2GTP Inverse Protocol Version (1 byte: 0xFE)
    const octetstring c_V2GTP_InvProtocolVersion  := 'FE'O;
    // V2GTP Payload Type for V2G application messages (2 bytes: 0x8001)
    const octetstring c_V2GTP_PayloadType_V2GMsg  := '8001'O;
    // V2GTP Payload Type for SDP (2 bytes: 0x9000)
    const octetstring c_V2GTP_PayloadType_SDP     := '9000'O;

    // ==========================================
    // Section 5: V2GTP Header Request/Response Types
    // ==========================================

    type record V2GTPHeaderReqType {
        octetstring  protocolVersion,
        octetstring  inverseProtocolVersion,
        octetstring  payloadType,
        integer      payloadLength,
        octetstring  payload optional
    }

    type record V2GTPHeaderResType {
        octetstring  protocolVersion,
        octetstring  inverseProtocolVersion,
        octetstring  payloadType,
        integer      payloadLength,
        octetstring  payload optional
    }

    // ==========================================
    // Section 6: SDP Types
    // ==========================================

    type record SDPRequestType {
        octetstring  security,
        octetstring  transportProtocol
    }

    type record SDPResponseType {
        octetstring  seccIpAddress,
        octetstring  seccPort,
        octetstring  security,
        octetstring  transportProtocol
    }

    // ==========================================
    // Section 7: Generic V2G Message Envelope
    // ==========================================

    type record V2GMessageType {
        octetstring  header,
        octetstring  body optional
    }

} // end of module SECC_Types
