module f_SECC_CMN_PO_ShutdownConfiguration_001 {

    /**
     * @desc    Postcondition: Shutdown test configuration.
     *          Unmaps all ports and performs final cleanup after test execution.
     * @reference ISO 15118-2
     * @requirement V2G2-082
     */

    import from SECC_TestSystem all;

    function f_SECC_CMN_PO_ShutdownConfiguration_001()
        runs on SECCTester
        return verdicttype
    {
        // Phase D: Unmap all ports and shutdown configuration
        log("PostCondition: Shutting down test configuration");

        unmap(mtc:pt_V2G_TCP_TLS_ALM_SECC_Port, system:pt_V2G_TCP_TLS_ALM_SECC_Port);
        unmap(mtc:pt_V2G_UDP_SDP_Port, system:pt_V2G_UDP_SDP_Port);

        log("PostCondition: All ports unmapped, configuration shutdown complete");
        return pass;
    }

} // end of module f_SECC_CMN_PO_ShutdownConfiguration_001
