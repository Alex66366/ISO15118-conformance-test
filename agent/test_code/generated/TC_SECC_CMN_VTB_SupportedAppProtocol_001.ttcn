module TC_SECC_CMN_VTB_SupportedAppProtocol_001 {
    import from SECC_TestSystem all;
    import from SECC_Constants all;
    import from SECC_CmnTemplates all;
    import from PreConditions_SECC_15118_2 all;
    import from PostConditions_SECC_15118_2 all;
    import from f_SECC_CMN_PR_InitConfiguration_001 all;
    import from f_SECC_CMN_PR_SupportedAppProtocol_001 all;
    import from f_SECC_CMN_TB_VTB_SupportedAppProtocol_001 all;
    import from f_SECC_CMN_PO_InitialState_001 all;
    import from f_SECC_CMN_PO_ShutdownConfiguration_001 all;

    /**
     * @desc    GoodCase test case for SupportedAppProtocol exchange.
     *          Tests that SECC returns a valid SupportedAppProtocolRes
     *          after receiving a valid SupportedAppProtocolReq.
     *
     *          NOTE: covered_by_precondition = true — the actual
     *          SupportedAppProtocol exchange is already performed by
     *          f_SECC_CMN_PR_SupportedAppProtocol_001 in the pre-condition
     *          chain. The TB function short-circuits to setverdict(pass).
     *
     * Pattern: 4-phase test execution model
     *   Phase A: Initialize (map ports)
     *   Phase B: Precondition (SDP + AppProtocol exchange)
     *   Phase C: Test behavior (short-circuit: already covered)
     *   Phase D: Postcondition (cleanup)
     */
    testcase TC_SECC_CMN_VTB_SupportedAppProtocol_001()
        runs on SECCTester system SystemSECC
    {
        var verdicttype preConVerdict;

        // Phase A+B: Pre Conditions (SIL mode)
        f_SECC_CMN_PR_InitConfiguration_001();
        preConVerdict := f_SECC_CMN_PR_SupportedAppProtocol_001();

        // Phase C: Test behavior
        if (preConVerdict == pass) {
            f_SECC_CMN_TB_VTB_SupportedAppProtocol_001();
        } else {
            log("PreCondition verdict is not pass");
            setverdict(inconc);
        }

        // Phase D: Post Conditions (unconditional cleanup)
        f_SECC_CMN_PO_InitialState_001();
        f_SECC_CMN_PO_ShutdownConfiguration_001();
    }
}