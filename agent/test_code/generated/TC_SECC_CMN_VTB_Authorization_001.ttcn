module TC_SECC_CMN_VTB_Authorization_001 {

    import from SECC_TestSystem all;
    import from SECC_Constants all;
    import from PreConditions_SECC_15118_2 all;
    import from PostConditions_SECC_15118_2 all;
    import from f_SECC_CMN_PR_InitConfiguration_001 all;
    import from f_SECC_CMN_PR_SupportedAppProtocol_001 all;
    import from f_SECC_CMN_PR_SessionSetup_001 all;
    import from f_SECC_CMN_PR_ServiceDiscovery_001 all;
    import from f_SECC_CMN_PR_PaymentServiceSelection_001 all;
    import from f_SECC_CMN_TB_VTB_Authorization_001 all;
    import from f_SECC_CMN_PO_InitialState_001 all;
    import from f_SECC_CMN_PO_ShutdownConfiguration_001 all;

    testcase TC_SECC_CMN_VTB_Authorization_001()
        runs on SECCTester system SystemSECC
    {
        var verdicttype preConVerdict;

        // Phase A+B: Initialize and establish session state
        f_SECC_CMN_PR_InitConfiguration_001();
        preConVerdict := f_SECC_CMN_PR_SupportedAppProtocol_001();
        if (preConVerdict != pass) {
            log("SupportedAppProtocol precondition failed");
            setverdict(inconc);
            f_SECC_CMN_PO_InitialState_001();
            f_SECC_CMN_PO_ShutdownConfiguration_001();
            return;
        }
        preConVerdict := f_SECC_CMN_PR_SessionSetup_001();
        if (preConVerdict != pass) {
            log("SessionSetup precondition failed");
            setverdict(inconc);
            f_SECC_CMN_PO_InitialState_001();
            f_SECC_CMN_PO_ShutdownConfiguration_001();
            return;
        }
        preConVerdict := f_SECC_CMN_PR_ServiceDiscovery_001();
        if (preConVerdict != pass) {
            log("ServiceDiscovery precondition failed");
            setverdict(inconc);
            f_SECC_CMN_PO_InitialState_001();
            f_SECC_CMN_PO_ShutdownConfiguration_001();
            return;
        }
        preConVerdict := f_SECC_CMN_PR_PaymentServiceSelection_001();
        if (preConVerdict != pass) {
            log("PaymentServiceSelection precondition failed");
            setverdict(inconc);
            f_SECC_CMN_PO_InitialState_001();
            f_SECC_CMN_PO_ShutdownConfiguration_001();
            return;
        }

        // Phase C: Test Authorization exchange
        f_SECC_CMN_TB_VTB_Authorization_001();

        // Phase D: PostConditions (unconditional)
        f_SECC_CMN_PO_InitialState_001();
        f_SECC_CMN_PO_ShutdownConfiguration_001();

        // Cleanup
        unmap(mtc:pt_V2G_TCP_TLS_ALM_SECC_Port, system:pt_V2G_TCP_TLS_ALM_SECC_Port);
        unmap(mtc:pt_V2G_UDP_SDP_Port, system:pt_V2G_UDP_SDP_Port);
        stop;
    }
}
