module TC_SECC_CMN_VTB_SessionSetup_001 {
    import from SECC_TestSystem all;
    import from SECC_Types all;
    import from SECC_CmnTemplates all;
    import from SECC_Constants all;
    import from f_SECC_CMN_PR_InitConfiguration_001 all;
    import from f_SECC_CMN_PR_SupportedAppProtocol_001 all;
    import from f_SECC_CMN_TB_VTB_SessionSetup_001 all;
    import from f_SECC_CMN_PO_InitialState_001 all;
    import from f_SECC_CMN_PO_ShutdownConfiguration_001 all;

    /**
     * @desc    GoodCase test for SessionSetupReq/Res exchange
     *          Verifies SECC correctly establishes a new V2G communication session
     *          after SupportedAppProtocol negotiation.
     *
     * @reference [V2G2-082] [V2G2-086] [V2G2-087] [V2G2-088]
     *
     * Test structure (4 phases):
     *   Phase A: Map ports (TCP/TLS and UDP/SDP)
     *   Phase B: Preconditions (SDP discovery + SupportedAppProtocol)
     *   Phase C: Test behavior (SessionSetupReq/Res exchange)
     *   Phase D: Postconditions (cleanup)
     */
    testcase TC_SECC_CMN_VTB_SessionSetup_001()
        runs on SECCTester system SystemSECC
    {
        var verdicttype preConVerdict;

        // Phase A+B: Preconditions
        f_SECC_CMN_PR_InitConfiguration_001();
        preConVerdict := f_SECC_CMN_PR_SupportedAppProtocol_001();

        // Phase C: Test behavior (only if preconditions passed)
        if (preConVerdict == pass) {
            f_SECC_CMN_TB_VTB_SessionSetup_001();
        } else {
            log("PreCondition verdict is not pass, skipping test behavior");
            setverdict(inconc);
        }

        // Phase D: Postconditions (unconditional cleanup)
        f_SECC_CMN_PO_InitialState_001();
        f_SECC_CMN_PO_ShutdownConfiguration_001();
    }

}