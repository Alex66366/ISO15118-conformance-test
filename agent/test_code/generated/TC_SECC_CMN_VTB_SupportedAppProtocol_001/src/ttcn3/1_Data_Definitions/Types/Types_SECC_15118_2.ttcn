/**
 * @desc    Simplified type definitions stub for SECC ISO 15118-2 conformance tests.
 *          The generated test case imports from ISO15118_2_DataTypes (provided by
 *          the platform's EXI codec library).  This stub satisfies any local
 *          module-level type references and avoids circular import issues.
 *
 *          Full type definitions are provided by the codec library at link time.
 */
module SECC_Types {

    import from SECC_TestSystem all;

    // -------------------------------------------------------------------------
    // Primitive aliases (convenience)
    // -------------------------------------------------------------------------
    type integer  Uint8  (0..255);
    type integer  Uint16 (0..65535);
    type integer  Uint32 (0..4294967295);
    type charstring AnyURI;

    // -------------------------------------------------------------------------
    // SupportedAppProtocol types
    // -------------------------------------------------------------------------

    /** AppProtocol entry as per ISO 15118-2 Annex A */
    type record AppProtocolType {
        AnyURI  ProtocolNamespace,
        Uint8   VersionNumberMajor,
        Uint8   VersionNumberMinor,
        Uint8   SchemaID,
        Uint8   Priority
    }

    type record of AppProtocolType AppProtocols;

    type record SupportedAppProtocolReqType {
        AppProtocols AppProtocol
    }

    type enumerated responseCodeType {
        oK_SuccessfulNegotiation,
        oK_SuccessfulNegotiationWithMinorDeviation,
        fAILED_NoNegotiation
    }

    type record SupportedAppProtocolResType {
        responseCodeType ResponseCode,
        Uint8            SchemaID optional
    }

    // -------------------------------------------------------------------------
    // V2GTP framing types
    // -------------------------------------------------------------------------

    /** Raw V2G Transfer Protocol message (header + payload as octetstrings) */
    type record V2GTP_Message {
        octetstring Header,
        octetstring Payload
    }

} // end module SECC_Types
