/**
 * @desc    Component and Port type definitions for SECC ISO 15118-2 conformance testing.
 *          Generated for TC_SECC_CMN_VTB_SupportedAppProtocol_001.
 *
 * @note    TITAN build step: ttcn3_compiler -t ComponentsAndPorts.ttcn
 *          This generates port skeleton files:
 *            V2G__TCP__TLS__Port.hh / V2G__TCP__TLS__Port.cc
 *            V2G__UDP__SDP__Port.hh / V2G__UDP__SDP__Port.cc
 *          (double-underscore = TITAN's encoding of underscore in identifiers)
 */
module SECC_TestSystem {

    // =========================================================================
    // Port Type Definitions
    // =========================================================================

    /**
     * @desc V2G TCP/TLS message port.
     *       Carries raw octetstring frames (V2GTP-encoded EXI payloads).
     *       TITAN generates skeleton: V2G__TCP__TLS__Port.hh / .cc
     */
    type port V2G_TCP_TLS_Port message {
        out octetstring;
        in  octetstring;
    }

    /**
     * @desc V2G UDP/SDP discovery port.
     *       Carries raw octetstring frames (SECC Discovery Protocol).
     *       TITAN generates skeleton: V2G__UDP__SDP__Port.hh / .cc
     */
    type port V2G_UDP_SDP_Port message {
        out octetstring;
        in  octetstring;
    }

    // =========================================================================
    // HAL 61851 Listener Type (used by precondition functions)
    // =========================================================================

    /**
     * @desc    Placeholder record type for IEC 61851 hardware abstraction listener.
     *          Precondition functions (generated by Core Agent) declare variables
     *          of this type.  Keep in sync with PreConditions module imports.
     */
    type record HAL_61851_Listener {
        charstring listener_id optional
    }

    // =========================================================================
    // Test Component Types
    // =========================================================================

    /**
     * @desc Main tester component for SECC conformance tests.
     *       Runs on SECCTester; system component is SystemSECC.
     */
    type component SECCTester {
        // Primary V2G TCP/TLS message port (SECC variant)
        port V2G_TCP_TLS_Port pt_V2G_TCP_TLS_ALM_SECC_Port;
        // SDP discovery port
        port V2G_UDP_SDP_Port pt_V2G_UDP_SDP_Port;
        // Timer for V2G message timeout (used by behavior functions)
        timer tc_V2G_SECC_Msg_Timer;
        // PIXIT-derived parameters (assigned in precondition)
        var float par_V2G_SECC_Msg_Timeout_SupportedAppProtocolReq := 2.0;
    }

    /**
     * @desc System component; represents the System Under Test (SECC).
     *       Ports here are mapped to the SECCTester ports at runtime.
     */
    type component SystemSECC {
        port V2G_TCP_TLS_Port pt_V2G_TCP_TLS_ALM_SECC_Port;
        port V2G_UDP_SDP_Port pt_V2G_UDP_SDP_Port;
    }

} // end module SECC_TestSystem
