module f_SECC_CMN_PR_Binding_001 {
    import from SECC_TestSystem all;
    import from ISO15118_2_PIXIT all;
    import from ISO15118_2_Templates all;

    /**
     * @desc Phase B: SDP discovery + TCP/TLS binding.
     *       Performs SECC Discovery Protocol (SDP) and establishes
     *       TCP/TLS connection with the SECC under test.
     */
    function f_SECC_CMN_PR_Binding_001(
        in HAL_61851_Listener v_HAL_61851_Listener
    ) runs on SECCTester return verdicttype {
        var timer tc_V2G_EVCC_Msg_Timer;
        tc_V2G_EVCC_Msg_Timer.start(PIXIT_CMN_Message_Timeout);

        // Perform SDP discovery
        f_SECC_CMN_PR_SDPDiscovery_001();

        // Establish TCP/TLS connection
        f_SECC_CMN_PR_TCPConnection_001();

        tc_V2G_EVCC_Msg_Timer.stop;
        setverdict(pass);

        return getverdict;
    }
}
