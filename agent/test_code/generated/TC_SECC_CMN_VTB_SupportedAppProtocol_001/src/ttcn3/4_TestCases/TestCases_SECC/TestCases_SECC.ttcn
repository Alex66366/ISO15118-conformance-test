/**
 * @desc    Test suite aggregator module for SECC ISO 15118-2 conformance tests.
 *          This module imports the generated test case and provides a control
 *          block that executes it against the SystemSECC component.
 *
 *          The pipeline places the generated test case at:
 *            src/ttcn3/4_TestCases/TC_SECC_CMN_VTB_SupportedAppProtocol_001.ttcn
 */
module TestCases_SECC {

    import from SECC_TestSystem all;
    import from TC_SECC_CMN_VTB_SupportedAppProtocol_001 all;

    // =========================================================================
    // Control block: sequentially execute all test cases in this suite
    // =========================================================================
    control {
        execute(TC_SECC_CMN_VTB_SupportedAppProtocol_001());
    }

} // end module TestCases_SECC
