/**
 * @desc    GoodCase: Tests that SECC correctly processes SupportedAppProtocolReq
 *          and responds with SupportedAppProtocolRes containing responseCode
 *          oK_SuccessfulNegotiation or oK_SuccessfulNegotiationWithMinorDeviation.
 * @reference ISO 15118-2:2014, Section 8.4.2
 * @requirement V2G2-082
 */
module TC_SECC_CMN_VTB_SupportedAppProtocol_001 {

  // === Imports ===
  import from ISO15118_2_DataTypes all;
  import from ISO15118_2_Templates all;
  import from ISO15118_2_Functions all;
  import from ISO15118_2_Components all;
  import from ISO15118_2_PICS all;
  import from ISO15118_2_PIXIT all;
  import from ISO15118_2_Timers all;
  import from PreConditions_SECC_15118_2 all;
  import from PostConditions_SECC_15118_2 all;

  // === Test Behavior Function ===
  function f_SECC_CMN_TB_VTB_SupportedAppProtocol_001()
    runs on SECCTester
    return verdicttype
  {
    // Start message timeout timer
    tc_V2G_SECC_Msg_Timer.start(par_V2G_SECC_Msg_Timeout_SupportedAppProtocolReq);

    // Send SupportedAppProtocolReq via SECC port
    pt_V2G_TCP_TLS_ALM_SECC_Port.send(
      md_CMN_V2GTP_Message_001(
        md_CMN_V2GTP_Header_001('01'O, 'FE'O, '8001'O, omit),
        md_CMN_V2GTP_Payload_001(
          md_CMN_SupportedAppProtocolReq_001()
        )
      )
    );

    alt {
      // PASS: SECC responds with successful negotiation
      [] pt_V2G_TCP_TLS_ALM_SECC_Port.receive(
        mw_CMN_V2GTP_Message_001(
          mw_CMN_V2GTP_Header_001('01'O, 'FE'O, '8002'O, ?),
          mw_CMN_V2GTP_Payload_001(
            mdw_SECC_SupportedAppProtocolRes_001(
              (oK_SuccessfulNegotiation, oK_SuccessfulNegotiationWithMinorDeviation)
            )
          )
        )
      ) {
        tc_V2G_SECC_Msg_Timer.stop;
        log("PASS: SECC responded with SupportedAppProtocolRes with successful negotiation responseCode");
        setverdict(pass, "SECC responded with SupportedAppProtocolRes containing oK_SuccessfulNegotiation or oK_SuccessfulNegotiationWithMinorDeviation");
      }
      // FAIL: SECC responds with unexpected responseCode or message type
      [] pt_V2G_TCP_TLS_ALM_SECC_Port.receive(?) {
        tc_V2G_SECC_Msg_Timer.stop;
        log("FAIL: SECC sent unexpected message or responseCode");
        setverdict(fail, "SECC responded with unexpected message or non-successful responseCode");
      }
      // INCONC: Timer expired before receiving SupportedAppProtocolRes
      [] tc_V2G_SECC_Msg_Timer.timeout {
        log("INCONC: Timeout waiting for SupportedAppProtocolRes");
        setverdict(inconc, "Timer expired before receiving SupportedAppProtocolRes");
      }
    }

    return getverdict;
  }

  // === Testcase ===
  testcase TC_SECC_CMN_VTB_SupportedAppProtocol_001()
    runs on SECCTester system SystemSECC
  {
    var HAL_61851_Listener v_HAL_61851_Listener;
    var verdicttype preConVerdict;

    // -- Phase A+B: Pre Conditions --
    // f_SECC_CMN_PR_InitConfiguration_001: creates PTC, maps ports, initializes variables
    // f_SECC_CMN_PR_Binding_001: SDP discovery + TCP/TLS binding
    // f_SECC_CMN_PR_InitConfiguration_002: additional configuration for test behavior
    f_SECC_CMN_PR_InitConfiguration_001(v_HAL_61851_Listener, system);
    preConVerdict := f_SECC_CMN_PR_Binding_001(v_HAL_61851_Listener);

    // -- Phase C: Test behavior --
    if (preConVerdict == pass) {
      f_SECC_CMN_PR_InitConfiguration_002(system, pass, fail);
      f_SECC_CMN_TB_VTB_SupportedAppProtocol_001();
    } else {
      log("PreCondition verdict is not pass");
      setverdict(inconc);
    }

    // -- Phase D: Post Conditions (unconditional cleanup) --
    // f_SECC_CMN_PO_InitialState_001: unmaps ports, stops PTC
    // f_SECC_CMN_PO_ShutdownConfiguration_001: closes TCP/TLS connection
    f_SECC_CMN_PO_InitialState_001(v_HAL_61851_Listener);
    f_SECC_CMN_PO_ShutdownConfiguration_001(v_HAL_61851_Listener, system);
  }
}
