module TC_SECC_CMN_VTB_PaymentServiceSelection_001 {

    import from SECC_TestSystem all;
    import from SECC_CmnTemplates all;
    import from SECC_Constants all;

    // Direct imports for all function modules called
    import from f_SECC_CMN_PR_InitConfiguration_001 all;
    import from f_SECC_CMN_PR_SupportedAppProtocol_001 all;
    import from f_SECC_CMN_PR_SessionSetup_001 all;
    import from f_SECC_CMN_PR_ServiceDiscovery_001 all;
    import from f_SECC_CMN_TB_VTB_PaymentServiceSelection_001 all;
    import from f_SECC_CMN_PO_InitialState_001 all;
    import from f_SECC_CMN_PO_ShutdownConfiguration_001 all;

    /**
     * @desc    GoodCase test for PaymentServiceSelection exchange (ISO 15118-2)
     *          Tests that SECC correctly processes ServicePaymentSelectionReq
     *          with valid SelectedPaymentOption and returns OK response.
     *
     * Pattern: 4-phase test execution model
     *   Phase A: Initialize (map ports - SIL mode)
     *   Phase B: Precondition chain (SDP, AppProtocol, SessionSetup, ServiceDiscovery)
     *   Phase C: Test behavior (send PaymentServiceSelectionReq, verify Res)
     *   Phase D: Postcondition (cleanup)
     */
    testcase TC_SECC_CMN_VTB_PaymentServiceSelection_001()
        runs on SECCTester system SystemSECC
    {
        var verdicttype preConVerdict;

        // Phase A+B: Pre Conditions (SIL mode - no PTC)
        f_SECC_CMN_PR_InitConfiguration_001();
        preConVerdict := f_SECC_CMN_PR_SupportedAppProtocol_001();
        if (preConVerdict == pass) {
            preConVerdict := f_SECC_CMN_PR_SessionSetup_001(vc_SessionID);
        }
        if (preConVerdict == pass) {
            preConVerdict := f_SECC_CMN_PR_ServiceDiscovery_001();
        }

        // Phase C: Test behavior (only if preconditions passed)
        if (preConVerdict == pass) {
            f_SECC_CMN_TB_VTB_PaymentServiceSelection_001();
        } else {
            log("PreCondition was unsuccessful, skipping test behavior");
            setverdict(inconc);
        }

        // Phase D: Post Conditions (unconditional cleanup)
        f_SECC_CMN_PO_InitialState_001();
        f_SECC_CMN_PO_ShutdownConfiguration_001();
    }
}
