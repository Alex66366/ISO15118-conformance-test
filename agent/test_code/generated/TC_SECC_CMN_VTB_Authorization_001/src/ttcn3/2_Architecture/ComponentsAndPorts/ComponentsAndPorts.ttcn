module SECC_TestSystem {
    import from SECC_Types all;

    // ==========================================
    // V2G_PortMessage — typed receive-side union (Sprint 3, 2026-07-11)
    // ==========================================
    // The receive side of V2G_TCP_TLS_Port uses V2G_PortMessage, while the
    // send side stays as OCTETSTRING (backward compatible with the v4 Dumb
    // Terminal architecture — TTCN-3 owns JSON well-formedness, the C++
    // adapter just passes UTF-8 bytes through the EXI microservice).
    //
    // Two variants on the receive side:
    //   { raw := <decoded_json_bytes> }: success — SECC bytes were stripped
    //                                   of V2GTP header, decoded via the EXI
    //                                   microservice, JSON passed through as
    //                                   UTF-8 octetstring. TTCN-3 then
    //                                   applies its typed receive pattern
    //                                   (e.g. { sessionSetupRes := ... }).
    //                                   NOTE: The TITAN receive template
    //                                   engine matches the inner pattern
    //                                   against the inner value of the
    //                                   union alternative.
    //   { error_indicator := V2G_ErrorInfo }: fail-fast — the C++ adapter
    //                                   detected a non-recoverable error
    //                                   (DECODE ERROR, microservice
    //                                   unavailable, V2GTP framing invalid,
    //                                   or oversized payload). TTCN-3
    //                                   immediately matches
    //                                     receive({ error_indicator := ? })
    //                                   and sets verdict=fail, terminating
    //                                   the per-TC run within seconds instead
    //                                   of waiting for the per-TC message
    //                                   timeout (~20 min).
    // ==========================================
    type union V2G_PortMessage {
        V2G_MessageUnion  v2g,
        octetstring       raw,
        V2G_ErrorInfo     error_indicator
    }

    // ==========================================
    // V2G_TCP_TLS_Port
    // ==========================================
    // out:  OCTETSTRING (unchanged from v4 Dumb Terminal). The C++ adapter
    //       receives UTF-8 JSON bytes via outgoing_send(OCTETSTRING),
    //       forwards them to the EXI microservice for encoding, prepends the
    //       V2GTP header, and sends over TCP.
    // in :  V2G_PortMessage (extended in Sprint 3). The C++ adapter receives
    //       SECC bytes, strips the V2GTP header, and either:
    //         - on success: pushes
    //             incoming_message({ raw := <decoded JSON bytes> })
    //         - on DECODE ERROR / microservice failure / framing failure:
    //             incoming_message({ error_indicator := ... })
    //       so TTCN-3 can fail the test case immediately instead of silently
    //       dropping the message.
    //
    // This split-direction design avoids a Smart Adapter refactor on the
    // outgoing path (TTCN-3 continues to emit JSON via outgoing_send).
    // The Smart Adapter for outgoing { v2g := ... } support is a future task.
    // ==========================================
    type port V2G_TCP_TLS_Port message {
        // Sprint 2 Dumb Terminal out: the C++ adapter implements
        // `outgoing_send(const ::OCTETSTRING& json_payload)` which is the
        // transparent UTF-8 byte pipe from TTCN-3 to the Python EXI
        // microservice.  This shape matches what worked on 2026-07-11
        // (3/10 pass) before Sprint 3's union refactor, which broke the
        // C++ adapter signature.  Keep `out octetstring` until the C++
        // adapter is upgraded to dispatch on V2G_PortMessage variants.
        out octetstring;
        in  V2G_PortMessage;
    }

    type port V2G_UDP_SDP_Port message {
        out octetstring;
        in  octetstring;
    }

    // ==========================================
    // Section 2: Component Types
    // ==========================================

    type component SECCTester {
        port V2G_TCP_TLS_Port pt_V2G_TCP_TLS_ALM_SECC_Port;
        port V2G_UDP_SDP_Port pt_V2G_UDP_SDP_Port;
    }

    type component SystemSECC {
        port V2G_TCP_TLS_Port pt_V2G_TCP_TLS_ALM_SECC_Port;
        port V2G_UDP_SDP_Port pt_V2G_UDP_SDP_Port;
    }

} // end of module
