module SECC_CmnTemplates {
    import from SECC_Types all;

    // ==========================================
    // Section 1: Common Timeout Altsteps
    // ==========================================

    altstep a_CMN_WaitTimeout(inout timer p_timer) {
        [] p_timer.timeout {
            setverdict(inconc, "Timeout occurred");
        }
    }

    // ==========================================
    // Section 2: Verdict Helpers
    // ==========================================

    function f_CMN_IsVerdictPass(in verdicttype p_verdict) return boolean {
        return (p_verdict == pass);
    }

    function f_CMN_VerdictToCharstring(in verdicttype p_verdict) return charstring {
        if (p_verdict == pass)    { return "pass"; }
        if (p_verdict == fail)    { return "fail"; }
        if (p_verdict == inconc)  { return "inconc"; }
        return "none";
    }

    // ==========================================
    // Section 3: V2G Message Templates (structured V2G_MessageUnion)
    // ==========================================
    // V2G_TCP_TLS_Port uses 'V2G_MessageUnion' for in/out.
    // The C++ V2G_TCP_TLS_Port adapter receives these structured values
    // in outgoing_send(), calls ExiCodecAdapter::encode() to look up the
    // pre-encoded wire_hex from exi_payload_library.json, patches the V2GTP
    // length field, and sends over TCP.
    //
    // SOP for every V2G message:
    //   STEP 1: Lookup wire_hex in exi_payload_library.json
    //   STEP 2: Locate md_CMN_{Msg}Req_001 / mdw_SECC_{Msg}Res_001 here
    //   STEP 3: Send via structured union: send({ msgType := md_CMN_MsgReq_001 })
    //   STEP 4: Receive via matching template, stop timer, setverdict
    //
    // NOTE: These templates use omit for optional fields, producing partial EXI
    // encodings that match the canonical wire_hex in exi_payload_library.json.

    // ----- SupportedAppProtocolReq templates -----
    // Canonical wire_hex: 01FE8001000000248000EBAB9371D34B9B79D189A98989C1D191D191818999D26B9B3A232B30020000040040

    template SupportedAppProtocolReq md_CMN_SupportedAppProtocolReq_001 := {
        protocolArray := omit
    };

    // ----- SupportedAppProtocolRes templates -----
    // Canonical wire_hex OK:   01FE80010000000480400040
    // Canonical wire_hex Fail: 01FE80010000000480400000

    template SupportedAppProtocolRes md_CMN_SupportedAppProtocolRes_001 := {
        ResponseCode := 0,
        SchemaID := 1,
        SchemaURI := omit
    };

    template SupportedAppProtocolRes md_CMN_SupportedAppProtocolRes_002 := {
        ResponseCode := 1,
        SchemaID := omit,
        SchemaURI := omit
    };

    // ----- SessionSetupReq templates -----
    // Canonical wire_hex: 01FE800100000014809802000000000000000011D015512551053800
    // (SessionID placeholder: 0000000000000000, EVCCID = TITAN)

    template SessionSetupReq md_CMN_SessionSetupReq_001 := {
        EVCCID := "PLATFORM123456",
        DEXArray := omit
    };

    template SessionSetupReq md_CMN_SessionSetupReq_002 := {
        EVCCID := "",
        DEXArray := omit
    };

    // ----- SessionSetupRes templates -----
    // Canonical wire_hex OK:   01FE800100000020809802000000000000000011E000491114A9250D14A8C4C8CCD0D4A8C0C0C480
    // Canonical wire_hex Fail: 01FE800100000020809802000000000000000011E100491114A9250D14A8C4C8CCD0D4A8C0C0C480
    //
    // EVSEID: The C++ decoder extracts raw EVSEID bytes from the SECC's EXI response
    // and sets them as a hex string. The test behavior uses the lenient template (?),
    // which accepts any field values, allowing dynamic EVSEID from real SECCs.
    template SessionSetupRes md_CMN_SessionSetupRes_001 := {
        ResponseCode := 1,  // OK_NewSessionEstablished
        EVSEID := "",        // Placeholder — decoder overrides with real SECC bytes
        EVSETimeStamp := omit
    };

    template SessionSetupRes md_CMN_SessionSetupRes_002 := {
        ResponseCode := 1,
        EVSEID := "000000000",
        EVSETimeStamp := omit
    };

    // ----- ServiceDiscoveryReq templates -----
    template ServiceDiscoveryReq md_CMN_ServiceDiscoveryReq_001 := {
        ServiceScope := omit,
        ServiceType := omit
    };

    // ----- ServiceDiscoveryRes templates -----
    template ServiceDiscoveryRes md_CMN_ServiceDiscoveryRes_001 := {
        ResponseCode := 0,
        PaymentOptionList := omit,
        ServiceList := omit
    };

    // ----- CableCheckReq templates -----
    template CableCheckReq md_CMN_CableCheckReq_001 := {
        dummy := omit
    };

    // ----- CableCheckRes templates -----
    template CableCheckRes md_CMN_CableCheckRes_001 := {
        ResponseCode := 0,
        EVSEProcessing := 0
    };

    template CableCheckRes md_CMN_CableCheckRes_002 := {
        ResponseCode := 1,
        EVSEProcessing := 0
    };

    // ----- ChargeParameterDiscoveryReq templates -----
    template ChargeParameterDiscoveryReq md_CMN_ChargeParameterDiscoveryReq_001 := {
