    // ----- CertificateUpdateReq templates -----
    template CertificateUpdateReq md_CMN_CertificateUpdateReq_001 := {
        dummy := omit
    };

    // ----- CertificateUpdateRes templates -----
    template CertificateUpdateRes md_CMN_CertificateUpdateRes_001 := {
