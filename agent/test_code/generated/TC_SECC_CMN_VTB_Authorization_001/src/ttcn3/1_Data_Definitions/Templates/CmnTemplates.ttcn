        EVSEVoltage := omit,
        EVSECurrent := omit
    };

    // ----- ChargingStatusReq templates -----
    template ChargingStatusReq md_CMN_ChargingStatusReq_001 := {
        dummy := omit
    };

    // ----- ChargingStatusRes templates -----
    template ChargingStatusRes md_CMN_ChargingStatusRes_001 := {
        ResponseCode := 0,
        EVSEProcessing := omit
    };

    // ----- MeterReceiptReq templates -----
    template MeterReceiptReq md_CMN_MeterReceiptReq_001 := {
        ResponseCode := omit,
        MeteringSignature := omit
    };

    // ----- MeterReceiptRes templates -----
    template MeterReceiptRes md_CMN_MeterReceiptRes_001 := {
        ResponseCode := 0
    };

    // ----- WeldingDetectionReq templates -----
    template WeldingDetectionReq md_CMN_WeldingDetectionReq_001 := {
        dummy := omit
    };

    // ----- WeldingDetectionRes templates -----
    template WeldingDetectionRes md_CMN_WeldingDetectionRes_001 := {
