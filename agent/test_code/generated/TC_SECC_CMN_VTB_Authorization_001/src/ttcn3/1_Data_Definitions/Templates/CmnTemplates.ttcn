    // ----- PreChargeReq templates -----
    template PreChargeReq md_CMN_PreChargeReq_001 := {
        TargetVoltage := omit,
        TargetCurrent := omit
    };

    // ----- PreChargeRes templates -----
    template PreChargeRes md_CMN_PreChargeRes_001 := {
        ResponseCode := 0,
