    // ----- SessionStopRes templates -----
    template SessionStopRes md_CMN_SessionStopRes_001 := {
        ResponseCode := 0
    };

    // ----- AuthorizationReq templates -----
    template AuthorizationReq md_CMN_AuthorizationReq_001 := {
