module SECC_TestSystem {

    import from SECC_Types all;

    // ==========================================
    // Port type definitions
    //
    // V2G_TCP_TLS_Port: structured message type for V2G application messages.
    // TITAN serializes V2G_MessageUnion values to OCTETSTRING before calling
    // outgoing_send(). The C++ adapter intercepts this, calls
    // ExiCodecAdapter::encode() to look up pre-encoded wire_hex from
    // exi_payload_library.json, patches SessionID if needed, and sends over TCP.
    //
    // V2G_UDP_SDP_Port: raw octetstring for SDP protocol (no EXI encoding).
    // ==========================================

    type port V2G_TCP_TLS_Port message {
        out V2G_MessageUnion;
        in  V2G_MessageUnion;
    }

    type port V2G_UDP_SDP_Port message {
        out octetstring;
        in  octetstring;
    }

    // Component types
    type component SECCTester {
        port V2G_TCP_TLS_Port pt_V2G_TCP_TLS_ALM_SECC_Port;
        port V2G_UDP_SDP_Port pt_V2G_UDP_SDP_Port;
    }

    type component SystemSECC {
        port V2G_TCP_TLS_Port pt_V2G_TCP_TLS_ALM_SECC_Port;
        port V2G_UDP_SDP_Port pt_V2G_UDP_SDP_Port;
    }

} // end module SECC_TestSystem
