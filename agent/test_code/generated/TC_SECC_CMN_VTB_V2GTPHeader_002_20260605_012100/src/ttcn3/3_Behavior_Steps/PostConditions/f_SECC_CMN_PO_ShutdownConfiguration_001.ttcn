module f_SECC_CMN_PO_ShutdownConfiguration_001 {

    /**
     * @desc    PostCondition: Shutdown configuration.
     *          Unmaps all ports and releases resources.
     */

    import from SECC_TestSystem all;

    function f_SECC_CMN_PO_ShutdownConfiguration_001()
        runs on SECCTester
    {
        log("PostCondition: Shutting down configuration, unmapping ports");
        unmap(mtc:pt_V2G_TCP_TLS_ALM_SECC_Port, system:pt_V2G_TCP_TLS_ALM_SECC_Port);
        unmap(mtc:pt_V2G_UDP_SDP_Port, system:pt_V2G_UDP_SDP_Port);
        log("PostCondition: All ports unmapped, shutdown complete");
    }

} // end module f_SECC_CMN_PO_ShutdownConfiguration_001
