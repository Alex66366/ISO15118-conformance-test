module f_SECC_CMN_PO_InitialState_001 {

    /**
     * @desc    PostCondition: Reset to initial state.
     *          Clears any session state and prepares for next test.
     */

    import from SECC_TestSystem all;

    function f_SECC_CMN_PO_InitialState_001()
        runs on SECCTester
    {
        log("PostCondition: Resetting to initial state");
        // Clear any pending messages on the TCP port
        timer t_flush;
        t_flush.start(0.5);
        alt {
            [] pt_V2G_TCP_TLS_ALM_SECC_Port.receive {
                repeat;
            }
            [] t_flush.timeout {
                log("PostCondition: Port flushed, initial state restored");
            }
        }
    }

} // end module f_SECC_CMN_PO_InitialState_001
