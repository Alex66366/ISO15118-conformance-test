module f_SECC_CMN_TB_VTB_V2GTPHeader_002 {

    /**
     * @desc    Test behavior function for TC_SECC_CMN_VTB_V2GTPHeader_002.
     *          BadCase: Send V2GTP message with invalid ProtocolVersion=0x02
     *          (valid is 0x01 per V2G2-082). InverseProtocolVersion=0xFD (0x02 XOR 0xFF).
     *          Expect SECC to reject/close connection -- do NOT return a V2G app response.
     * @requirement V2G2-082
     */

    import from SECC_TestSystem all;
    import from SECC_Types all;
    import from SECC_Constants all;

    function f_SECC_CMN_TB_VTB_V2GTPHeader_002()
        runs on SECCTester
        return verdicttype
    {
        timer tc_V2G_SECC_Msg_Timer;

        // Construct V2GTP message with INVALID ProtocolVersion=0x02, InvVersion=0xFD
        // Valid would be ProtocolVersion=0x01, InvProtocolVersion=0xFE
        // PayloadType=0x8001 (EXI V2G application message)
        // Minimal EXI payload body (2 bytes)
        var V2GTPHeaderReqType v_invalidReq := {
            protocolVersion        := '02'O,
            inverseProtocolVersion := 'FD'O,
            payloadType            := '8001'O,
            payloadLength          := '00000002'O,
            payload                := '0000'O
        };

        // Start timer before send
        tc_V2G_SECC_Msg_Timer.start(PX_SECC_CMN_Message_Timeout);

        // Send the malformed V2GTP message to SECC via V2G_MessageUnion
        log("Sending V2GTP message with invalid ProtocolVersion=0x02 (should be 0x01)");
        pt_V2G_TCP_TLS_ALM_SECC_Port.send(V2G_MessageUnion:{ v2gtpHeaderReq := v_invalidReq });

        // BadCase verdict logic:
        //   PASS: SECC closes TCP connection OR does not respond within timeout
        //   FAIL: SECC returns a normal V2G application-layer response (should not accept invalid version)
        alt {
            // SUT sends any response -- indicates it accepted the invalid message (fail)
            [] pt_V2G_TCP_TLS_ALM_SECC_Port.receive(V2G_MessageUnion:?) {
                tc_V2G_SECC_Msg_Timer.stop;
                log("FAIL: SECC returned a response despite invalid ProtocolVersion=0x02");
                setverdict(fail, "SECC should not accept V2GTP message with invalid ProtocolVersion -- V2G2-082 violation");
            }
            // Timeout -- SECC silently ignored / rejected the message (correct behavior)
            [] tc_V2G_SECC_Msg_Timer.timeout {
                log("PASS: SECC did not respond to invalid ProtocolVersion=0x02 (timeout)");
                setverdict(pass, "SECC correctly ignored V2GTP message with invalid ProtocolVersion=0x02");
            }
        }

        return getverdict;
    }

} // end module f_SECC_CMN_TB_VTB_V2GTPHeader_002
