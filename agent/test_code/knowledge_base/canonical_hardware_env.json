{
  "description": "Hardware Environment Configuration for V2G Conformance Test",
  "version": "1.0",

  "network": {
    "interface": "ens33",
    "ipv6_multicast_address": "ff02::01",
    "vlan_id": 0,
    "mtu": 1500,
    "timeout_ms": 5000
  },

  "udp_sdp": {
    "port": 15118,
    "timeout_ms": 2000,
    "retry_count": 3
  },

  "tcp_tls": {
    "port": 15118,
    "connection_timeout_ms": 10000,
    "tls_enabled": false,
    "tls_version": "1.2",
    "cipher_suites": [
      "TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256"
    ]
  },

  "slac": {
    "enabled": false,
    "interface": "ens33",
    "config_file": "./slac_config.json",
    "timeout_ms": 5000
  },

  "hal_61851": {
    "enabled": false,
    "device_path": "/dev/ttyUSB0",
    "baudrate": 115200,
    "databits": 8,
    "stopbits": 1,
    "parity": "none",
    "flow_control": "none"
  },

  "certificates": {
    "root_ca": "./certificates/v2g_root_ca.pem",
    "contract_cert": "./certificates/contract_certificate.pem",
    "private_key": "./certificates/private_key.pem"
  },

  "test_parameters": {
    "combined_testing_mode": false,
    "evcc_id": "123456789ABC",
    "max_repetition_sdp": 3,
    "default_timeout_ms": 2000,
    "communication_setup_timeout_ms": 6000
  },

  "logging": {
    "level": "INFO",
    "file": "./logs/system_logs/hardware.log",
    "console": true,
    "timestamp_format": "%Y-%m-%d %H:%M:%S.%f"
  },

  "hardware": {
    "type": "QCA7000",
    "spi_interface": "/dev/spidev0.0",
    "spi_mode": 0,
    "spi_speed_hz": 1000000
  }
}
