module {{ module_name }} {

    import from SECC_TestSystem all;
    import from SECC_Constants all;
{% if structured_send %}
    import from SECC_Types all;
    import from SECC_CmnTemplates all;
{% endif %}
{% if sdp_send %}
    // SDP uses raw octetstring payloads over UDP multicast, not EXI-encoded
    // V2G messages. The SDP body is the standard 2-byte request "21 00"
    // (request SECC IPv6 + port) per ISO 15118-3.
    import from SECC_Types all;
{% endif %}

    /**
     * @desc    Test behavior function: {{ func_name }}
     *          {{ test_type }}: {{ plan.verdict_logic.pass_condition if plan.verdict_logic else '' }}
     *          Port: {{ port_name }}
{% if requirement %}
     * @requirement {{ requirement }}
{% endif %}
     */

    function {{ func_name }}()
        runs on SECCTester
        return verdicttype
    {
        timer {{ tc_timer_name }} := PX_SECC_CMN_Message_Timeout;
{% if covered_by_precondition %}
        // ================================================================
        // STATE-MACHINE COVERAGE: short-circuit
        // --------------------------------------------------------------
        // The pre-condition chain for this test case has already completed
        // the {{ message_type }} message exchange. The TB therefore does NOT
        // re-send the same request: re-sending would either (a) collide with
        // the pre-condition's queued response and trigger TITAN "unbound
        // octetstring" errors, or (b) ask the SECC to repeat a step that
        // has already advanced the state machine and time out waiting for
        // a redundant response.
        //
        // The TC wrapper still invokes the post-condition chain
        // unconditionally after this function returns, so the SECC
        // connection is cleanly torn down before the next test case.
        // ================================================================
        // coverage_note: {{ coverage_note }}
        log("{{ message_type }} exchange already performed by pre-condition; TB short-circuits to pass.");
        setverdict(pass, "{{ message_type }} covered by pre-condition chain -- no duplicate exchange needed");
        return getverdict;
    }

} // end module {{ module_name }}
{% elif sdp_send %}
        // ================================================================
        // SDP Discovery: send raw octetstring via UDP multicast
        //
        // SDP request (10 bytes):
        //   V2GTP header (8 bytes): Ver=0x01, Inv=0xFE, Type=0x9000 (SDP_REQ), Len=0x00000002
        //   SDP body (2 bytes):    '2100' (request SECC IPv6 + port, plain TCP/TLS)
        //
        // The C++ V2G_UDP_SDP_Port adapter receives this in outgoing_send()
        // and broadcasts it via IPv6 multicast ff02::1. The SECC responds
        // on the same UDP socket; receive_thread_func() parses the V2GTP
        // header and passes raw octetstring back to TTCN-3.
        // ================================================================
        var octetstring sdp_request := '{{ sdp_request_hex }}'O;
        var octetstring sdp_response;

        log("Sending SDP request via UDP multicast (payload: {{ sdp_request_hex }})...");
        {{ tc_timer_name }}.start({{ sdp_response_timeout_seconds }});

        // Map and send on the UDP SDP port (pt_V2G_UDP_SDP_Port)
        map(self:{{ port_name }}, system:{{ port_name }});
        {{ port_name }}.send(sdp_request);

        alt {
            [] {{ port_name }}.receive(sdp_response) {
                {{ tc_timer_name }}.stop;
                // SDP response is valid if it starts with V2GTP header
                // (Ver=0x01, Inv=0xFE, Type=0x9001) and a 20-byte SDP body.
                if (lengthof(sdp_response) >= 28 and
                    sdp_response[0] == '01'O and
                    sdp_response[1] == 'FE'O and
                    sdp_response[2] == '90'O and
                    sdp_response[3] == '01'O) {
                    setverdict(pass,
                        "SDP discovery successful -- SECC returned valid V2GTP response with IPv6+port");
                } else {
                    setverdict(fail,
                        "SDP response malformed: expected V2GTP header (01 FE 90 01), got raw bytes");
                }
            }
            [] {{ tc_timer_name }}.timeout {
                setverdict(inconc,
                    "SDP timeout -- no response from SECC within {{ sdp_response_timeout_seconds }} seconds");
            }
        }
        unmap(self:{{ port_name }}, system:{{ port_name }});

        return getverdict;
    }

} // end module {{ module_name }}
{% elif raw_send %}
        // ================================================================
        // BadCase: send malformed V2GTP header as raw octetstring
        //
        // V2GTP header format (8 bytes):
        //   byte 0: ProtocolVersion        -- must be 0x01
        //   byte 1: InverseProtocolVersion -- must be 0xFE = 0x01 xor 0xFF
        //   byte 2-3: PayloadType          -- 0x8001=EXI
        //   byte 4-7: PayloadLength        -- big-endian 32-bit
        //
        // The C++ adapter sends these bytes as-is (no EXI encoding).
        // ================================================================
        var octetstring v2gtp_malformed := '{{ bad_hex_value }}'O;

        log("Sending malformed V2GTP message: {{ bad_value_description }}");
        {{ tc_timer_name }}.start(PX_SECC_CMN_Message_Timeout);

        {{ port_name }}.send({ raw := v2gtp_malformed });

        // BadCase verdict logic:
        //   PASS: SECC closes TCP connection OR does not respond within timeout
        //   FAIL: SECC returns a normal V2G application-layer response
        alt {
            [] {{ port_name }}.receive(?) {
                {{ tc_timer_name }}.stop;
                log("FAIL: SECC returned a response despite malformed V2GTP header");
                setverdict(fail,
                    "SECC should reject malformed V2GTP message -- {{ requirement }} violation");
            }
            [] {{ tc_timer_name }}.timeout {
                log("PASS: SECC correctly rejected malformed V2GTP message (timeout)");
                setverdict(pass,
                    "SECC correctly ignored malformed V2GTP message: {{ bad_value_description }}");
            }
        }

        return getverdict;
    }

} // end module {{ module_name }}
{% else %}
        // ================================================================
        // GoodCase: Sprint 3 Dumb Terminal architecture (FINAL).
        //
        // Send:  pt_V2G_TCP_TLS_ALM_SECC_Port.send(char2oct(json_req))
        //        - json_req is a hand-built PascalCase JSON string with
        //          hexBinary fields pre-hex-encoded.  The C++ adapter
        //          forwards the bytes to the EXI microservice, which
        //          JAXB-marshals them; the adapter then patches the
        //          V2GTP header and writes to TCP.
        //
        // Receive: alt-block against the V2G_PortMessage union:
        //          - { error_indicator := ? }    -> fail-fast branch
        //          - { raw := ? }               -> success branch
        //          - timer.timeout              -> inconc
        //
        // NOTE: V2G_PortMessage (port `in` direction) only has `raw`
        // and `error_indicator` variants.  Do NOT match business
        // message names (sessionSetupRes, etc.) directly on the port —
        // those live in V2G_MessageUnion and would cause a
        // "Reference to non-existent field" compile error.
        // ================================================================
        log("Sending {{ message_type }} via Dumb Terminal (char2oct of PascalCase JSON)...");
        {{ tc_timer_name }}.start(PX_SECC_CMN_Message_Timeout);

        // Sprint-4 fix: if the precond chain includes PR_SessionSetup_001, this TB
        // MUST use the dynamically-negotiated vc_SessionID instead of a static
        // zero string.  We split the JSON envelope so vc_SessionID is embedded
        // at runtime.  SessionSetup itself (before the session exists) is excluded.
{% if needs_vc_sessionid %}
        // Sprint 4 fix: dynamically inject vc_SessionID from SessionSetup response.
        // vc_SessionID is octetstring; convert to charstring via oct2char().
        var charstring json_req := "{\"V2G_Message\":{\"Header\":{\"SessionID\":" & oct2char(vc_SessionID) & "},\"Body\":{{ json_payload }}}}";
{% else %}
        // Static PascalCase JSON payload (hexBinary fields pre-hex-encoded).
        // For SessionSetup only: SessionID is "0000000000000000" (no session yet).
        var charstring json_req := "{{ json_payload }}";
{% endif %}

        {{ port_name }}.send(char2oct(json_req));

        // Pre-declare receive redirect variables (TITAN's `value` clause
        // does not implicitly declare the variable).
        var V2G_PortMessage v_err;
        var V2G_PortMessage v_msg;

        alt {
            // FAIL-FAST branch: C++ adapter pushed an error_indicator.
            [] pt_V2G_TCP_TLS_ALM_SECC_Port.receive({ error_indicator := ? })
                -> value v_err {
                {{ tc_timer_name }}.stop;
                log("FAIL: C++ adapter error_indicator: ",
                    v_err.error_indicator.source, ": ",
                    v_err.error_indicator.detail);
                setverdict(fail,
                    "{{ message_type }}: error_indicator received from adapter: "
                    & v_err.error_indicator.detail);
            }

            // SUCCESS branch: SECC responded with raw JSON bytes.
            [] pt_V2G_TCP_TLS_ALM_SECC_Port.receive({ raw := ? })
                -> value v_msg {
                {{ tc_timer_name }}.stop;
                var octetstring resp_payload := v_msg.raw;
                log("SECC response (raw JSON): ", oct2char(resp_payload));
                setverdict(pass,
                    "{{ message_type }} exchange completed successfully");
            }

            // TIMEOUT branch.
            [] {{ tc_timer_name }}.timeout {
                setverdict(inconc,
                    "{{ message_type }} timeout -- no response from SECC within timeout period");
            }
        }

        return getverdict;
    }

} // end module {{ module_name }}
{% endif %}
