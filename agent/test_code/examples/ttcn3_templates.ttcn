/**
 * @desc    Common template examples from ISO 15118-4 (SIL mode)
 *
 * Naming conventions:
 *   md_CMN_*   : Common send templates (defined inline)
 *   mw_CMN_*   : Common receive/matching templates (wildcard matching)
 *
 * IMPORTANT (SIL Mode):
 *   The V2G_TCP_TLS_Port port type is defined as `out octetstring; in octetstring;`.
 *   This means you MUST send and receive `octetstring`, NOT record types.
 *
 *   For sending, use octetstring concatenation:
 *     port.send('01'O & 'FE'O & '8001'O & int2oct(len, 4) & payload)
 *
 *   For receiving with wildcard matching:
 *     port.receive('01'O & 'FE'O & '8002'O & ?)  // matches V2GTP header
 *
 *   The templates below define the octetstring byte layout, NOT TTCN-3 template records.
 *   When generating code, inline the octetstring construction directly.
 */

// ==========================================
// V2GTP Header Octetstring Layout
// ==========================================
//
// V2GTP Header (8 bytes):
//   Byte 0: protocolVersion    = '01'O (1 byte)
//   Byte 1: invProtocolVersion = 'FE'O (1 byte)
//   Byte 2-3: payloadType     = '8001'O..'8004'O (2 bytes, big-endian)
//   Byte 4-7: payloadLength    = int2oct(len, 4) (4 bytes, big-endian)
//
// Common payload types:
//   '8001'O = SupportedAppProtocolReq/Res
//   '8002'O = SessionSetupReq/Res
//   '8003'O = ServiceDiscoveryReq/Res
//   '8004'O = SessionTerminationReq/Res
//
// Example: Build a V2GTP message for SupportedAppProtocolReq
//   var octetstring body := '0022'O;  // simplified EXI payload
//   var integer len := lengthof(body);
//   var octetstring msg := '01FE8001'O & int2oct(len, 4) & body;
//   port.send(msg);

// ==========================================
// Common Message Payload Structures (octetstring)
// ==========================================
//
// SupportedAppProtocolReq payload (simplified):
//   '0022'O  (schema ID for ISO 15118-2)
//
// SupportedAppProtocolRes payload:
//   '0022'O & [response_code]  (schema ID + response code)
//
// Common response codes (from SECC_Constants):
//   '00'O = OK
//   '01'O = OK_NEW_SESSION_ESTABLISHED
//   '80'O = FAILED

// ==========================================
// TCP Control Messages (octetstring)
// ==========================================
//
// TCP Close request:
//   port.send('00'O)
//
// TCP Close response:
//   port.receive('00'O)

// ==========================================
// Port Send/Receive Examples (SIL Mode)
// ==========================================
//
// Send a V2GTP message:
//   var octetstring payload := '0022'O;
//   var integer pl := lengthof(payload);
//   port.send('01FE8001'O & int2oct(pl, 4) & payload);
//
// Receive and match V2GTP header only (wildcard body):
//   port.receive('01'O & 'FE'O & '8002'O & ?)
//
// Receive and match specific body bytes:
//   port.receive('01'O & 'FE'O & '8002'O & int2oct(4, 4) & '002200'O)
