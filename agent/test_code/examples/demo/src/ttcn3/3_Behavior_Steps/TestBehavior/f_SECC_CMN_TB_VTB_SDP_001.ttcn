        log("STUB: f_SECC_CMN_TB_VTB_SDP_001 -- implement when adding SDP test case");
        // LAYER-1/3 FIX (2026-07-12): explicit setverdict() before return so
        // TITAN does NOT emit `Verdict: none`. Returning `pass` directly is
