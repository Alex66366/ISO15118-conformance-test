module f_SECC_CMN_TB_VTB_V2GTPSessionSetup_001 {

    import from SECC_TestSystem all;
    import from SECC_Types all;
    import from SECC_CmnTemplates all;
    import from SECC_Constants all;

    // ================================================================
    // Test Behavior Function: V2GTPSessionSetup GoodCase
    //
    // Sprint 2 Dumb Terminal protocol:
    //   Send:    port.send(char2oct(<well-formed JSON>))
    //   Receive: port.receive(?) -> value var octetstring  -- port "in" is octetstring
    //
    // The adapter extracts the namespace from the JSON key pattern:
    //   "V2G_Message"       -> urn:iso:15118:2:2013:MsgDef
    //   "supportedAppProtocolReq" -> urn:iso:15118:2:2010:AppProtocol
    //
    // IMPORTANT: ALL JSON keys are PascalCase XSD element names.
    // NEVER use camelCase or lowercase keys. Violations silently produce
    // 2-byte empty EXI or NullPointerException.
    // ================================================================

    function f_SECC_CMN_TB_VTB_V2GTPSessionSetup_001() runs on SECCTester return verdicttype {
        timer tc_V2G_SECC_Msg_Timer := PX_SECC_CMN_Message_Timeout;

        // V2G_Message + SessionSetupReq.
        //   SessionID  : 8 bytes hexBinary -> hex string (16 hex chars)
        //   EVCCID    : 6 bytes hexBinary -> hex string (12 hex chars)
        //   namespace  : urn:iso:15118:2:2013:MsgDef (detected from "V2G_Message" key)
        var charstring json_req :=
            "{\"V2G_Message\":{"
            & "\"Header\":{\"SessionID\":\"0011223344556677\"},"
            & "\"Body\":{\"SessionSetupReq\":{\"EVCCID\":\"ABCDEF012345\"}}}}";

        log("Phase C: Sending SessionSetupReq via OCTETSTRING JSON...");
        log("JSON payload: ", json_req);
        tc_V2G_SECC_Msg_Timer.start(PX_SECC_CMN_Message_Timeout);

        // Sprint 3 Dumb Terminal out: port.send(<octetstring JSON>).
        // C++ adapter forwards to EXI microservice for encoding, prepends V2GTP header.
        pt_V2G_TCP_TLS_ALM_SECC_Port.send(char2oct(json_req));

        // Pre-declare receive redirect variables (TITAN's `value` clause requires
        // pre-declared variables; v_err holds a V2G_PortMessage with the
        // error_indicator alternative, v_msg holds one with the raw alternative).
        var V2G_PortMessage v_err;
        var V2G_PortMessage v_msg;

        // Sprint 3 receive: port's `in` type is V2G_PortMessage = { raw, error_indicator }.
        //   { error_indicator := ? }: fail-fast on DECODE ERROR / framing / payload-too-large.
        //   { raw := ? }:           success — DECODED JSON bytes; TTCN-3 inspects with
        //                            oct2char() to dispatch typed templates.
        alt {
            // FAIL-FAST branch — MUST come first per Sprint 3 SOP.
            [] pt_V2G_TCP_TLS_ALM_SECC_Port.receive({ error_indicator := ? })
                -> value v_err {
                tc_V2G_SECC_Msg_Timer.stop;
                setverdict(fail,
                    "C++ adapter error_indicator: ",
                    v_err.error_indicator.source,
                    ": ", v_err.error_indicator.detail);
            }
            // SUCCESS branch — raw decoded JSON bytes from SECC.
            [] pt_V2G_TCP_TLS_ALM_SECC_Port.receive({ raw := ? })
                -> value v_msg {
                tc_V2G_SECC_Msg_Timer.stop;
                var octetstring resp_payload := v_msg.raw;
                var charstring resp_json := oct2char(resp_payload);
                log("SessionSetupRes received (raw JSON): ", resp_json);
                setverdict(pass, "SessionSetup exchange completed");
            }
            [] tc_V2G_SECC_Msg_Timer.timeout {
                setverdict(inconc, "SessionSetup timeout -- no response from SECC");
            }
        }

        return getverdict;
    }
}