module f_SECC_CMN_PR_InitConfiguration_001 {
    import from SECC_TestSystem all;

    function f_SECC_CMN_PR_InitConfiguration_001() runs on SECCTester {
        // Map test system ports before use
        map(self:pt_V2G_TCP_TLS_ALM_SECC_Port, system:pt_V2G_TCP_TLS_ALM_SECC_Port);
        map(self:pt_V2G_UDP_SDP_Port, system:pt_V2G_UDP_SDP_Port);

        // SDP Discovery: Send SDP request via UDP multicast to discover SECC
        // This will trigger SECC to start its TCP server

        // SDP Request payload (V2GTP header + SDP request body)
        // V2GTP Header: version=1, inv_version=254, payload_type=0x9000, payload_length=2
        // SDP Request body: '2100' means "request SECC IPv6 address" (per ISO 15118-3)
        var octetstring sdp_request := '01FE9000000000021000'O;

        // Send SDP request via UDP
        pt_V2G_UDP_SDP_Port.send(sdp_request);

        // Wait for SDP response
        timer t_sdp;
        t_sdp.start(5.0);

        alt {
            [] pt_V2G_UDP_SDP_Port.receive {
                t_sdp.stop;
                log("SDP discovery completed, SECC TCP server should be ready");
            }
            [] t_sdp.timeout {
                log("SDP timeout, proceeding anyway...");
            }
        }
    }
}
