module f_SECC_CMN_PR_SupportedAppProtocol_001 {

    import from SECC_TestSystem all;
    import from SECC_Types all;
    import from SECC_CmnTemplates all;
    import from SECC_Constants all;

    // ================================================================
    // Precondition Function: SupportedAppProtocol GoodCase
    //
    // SOP for every V2G message:
    //   STEP 1: Lookup wire_hex in exi_payload_library.json
    //   STEP 2: Locate md_CMN_{Msg}Req_001 / mdw_SECC_{Msg}Res_001 in SECC_CmnTemplates.ttcn
    //   STEP 3: Send via structured union: send({ msgType := md_CMN_MsgReq_001 })
    //   STEP 4: Receive via matching template, stop timer, setverdict, return
    //
    // How it works:
    //   1. TTCN-3 sends a V2G_MessageUnion value via the port.
    //   2. The C++ V2G_TCP_TLS_Port receives it in outgoing_send(),
    //      calls ExiCodecAdapter::encode() with the message key to look up
    //      the pre-encoded wire_hex from exi_payload_library.json, patches
    //      V2GTP length field, and sends it over TCP.
    //   3. The SECC responds; the C++ adapter receives wire bytes, logs them,
    //      and passes the raw OCTETSTRING back to TTCN-3 as the response.
    // ================================================================

    function f_SECC_CMN_PR_SupportedAppProtocol_001() runs on SECCTester return verdicttype {
        timer tc_V2G_EVCC_Msg_Timer := PX_SECC_CMN_Message_Timeout;

        // Phase B: Send SupportedAppProtocolReq via structured union
        // The C++ port adapter intercepts and encodes via ExiCodecAdapter
        log("Phase B: Sending SupportedAppProtocolReq via structured union...");
        tc_V2G_EVCC_Msg_Timer.start(PX_SECC_CMN_Message_Timeout);

        pt_V2G_TCP_TLS_ALM_SECC_Port.send(
            { v2g := { supportedAppProtocolReq := md_CMN_SupportedAppProtocolReq_001 } }
        );

        alt {
            [] pt_V2G_TCP_TLS_ALM_SECC_Port.receive(
                { supportedAppProtocolRes := md_CMN_SupportedAppProtocolRes_001 }
            ) {
                tc_V2G_EVCC_Msg_Timer.stop;
                log("SupportedAppProtocolRes received: protocol negotiation complete");
                log("SessionID initialized to 0000000000000000 (new session)");
                setverdict(pass, "SupportedAppProtocol exchange successful -- protocol negotiated");
            }
            [] pt_V2G_TCP_TLS_ALM_SECC_Port.receive(
                { supportedAppProtocolRes := md_CMN_SupportedAppProtocolRes_002 }
            ) {
                tc_V2G_EVCC_Msg_Timer.stop;
                setverdict(fail, "SECC rejected the protocol negotiation");
            }
            [] pt_V2G_TCP_TLS_ALM_SECC_Port.receive {
                tc_V2G_EVCC_Msg_Timer.stop;
                setverdict(fail, "Unexpected message received during SupportedAppProtocol");
            }
            [] tc_V2G_EVCC_Msg_Timer.timeout {
                setverdict(inconc, "Timeout waiting for SupportedAppProtocolRes");
            }
        }

        return getverdict;
    }
}
