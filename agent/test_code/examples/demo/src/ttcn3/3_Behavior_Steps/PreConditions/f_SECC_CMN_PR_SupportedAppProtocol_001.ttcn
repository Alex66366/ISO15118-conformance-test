module f_SECC_CMN_PR_SupportedAppProtocol_001 {

    import from SECC_TestSystem all;
    import from SECC_Types all;
    import from SECC_CmnTemplates all;
    import from SECC_Constants all;

    // ================================================================
    // Precondition Function: SupportedAppProtocol GoodCase
    //
    // Sprint 3 Dumb Terminal protocol (port `in` is V2G_PortMessage):
    //   Send (port `out` is octetstring):
    //     pt_V2G_TCP_TLS_ALM_SECC_Port.send(char2oct(<well-formed JSON>))
    //   Receive alt-block template:
    //     alt {
    //       [] pt_V2G_TCP_TLS_ALM_SECC_Port.receive({ error_indicator := ? })
    //           -> value v_err { setverdict(fail, ...); }   // FAIL-FAST (MANDATORY 1st branch)
    //       [] pt_V2G_TCP_TLS_ALM_SECC_Port.receive({ raw := ? })
    //           -> value v_msg { var octetstring j := v_msg.raw; ... }  // SUCCESS
    //       [] tc_V2G_EVCC_Msg_Timer.timeout { setverdict(inconc, ...); }
    //     }
    //
    // The adapter is a pure transparent pipe. JSON correctness is the
    // SOLE responsibility of the TTCN-3 test code.
    //
    // IMPORTANT: The JSON below MUST use PascalCase XSD element names.
    // NEVER use camelCase or lowercase keys. See:
    //   generation_patterns.json::_ironclad_json_payload_rules
    //   core_agent_prompt.txt::Ironclad JSON Payload Rules
    // ================================================================

    function f_SECC_CMN_PR_SupportedAppProtocol_001() runs on SECCTester return verdicttype {
        timer tc_V2G_EVCC_Msg_Timer := PX_SECC_CMN_Message_Timeout;

        // The JSON payload below is the ONLY source of truth.
        // namespace for ISO 15118-2 V2G messages: urn:iso:15118:2:2013:MsgDef
        // All keys are PascalCase matching the XSD schema (NOT Java camelCase fields).
        var charstring json_req :=
            "{\"supportedAppProtocolReq\":{\"AppProtocol\":["
            & "{\"ProtocolNamespace\":\"urn:iso:15118:2:2013:MsgDef\","
            & "\"VersionNumberMajor\":2,"
            & "\"VersionNumberMinor\":0,"
            & "\"SchemaID\":1,"
            & "\"Priority\":1}"
            & "]}}";

        log("Phase B: Sending SupportedAppProtocolReq via OCTETSTRING JSON...");
        log("JSON payload: ", json_req);
        tc_V2G_EVCC_Msg_Timer.start(PX_SECC_CMN_Message_Timeout);

        // Sprint 2 Dumb Terminal out: port.send(<octetstring JSON>).
        pt_V2G_TCP_TLS_ALM_SECC_Port.send(char2oct(json_req));

        // Pre-declare receive redirect variables (TITAN's `value` clause requires
        // pre-declared variables; v_err holds a V2G_PortMessage with the
        // error_indicator alternative, v_msg holds one with the raw alternative).
        var V2G_PortMessage v_err;
        var V2G_PortMessage v_msg;

        // Sprint 3 receive: port's `in` type is V2G_PortMessage = { raw, error_indicator }.
        //   { error_indicator := ? }: FAIL-FAST branch (MUST be 1st per Sprint 3 SOP).
        //   { raw := ? }:           success — decoded JSON bytes; TTCN-3 dispatches
        //                            typed templates by inspecting v_msg.raw.
        alt {
            // FAIL-FAST branch — terminates run within ms on DECODE ERROR / framing failure.
            [] pt_V2G_TCP_TLS_ALM_SECC_Port.receive({ error_indicator := ? })
                -> value v_err {
                tc_V2G_EVCC_Msg_Timer.stop;
                setverdict(fail,
                    "C++ adapter error_indicator: ",
                    v_err.error_indicator.source,
                    ": ", v_err.error_indicator.detail);
            }
            // SUCCESS branch — raw decoded JSON bytes from SECC.
            [] pt_V2G_TCP_TLS_ALM_SECC_Port.receive({ raw := ? })
                -> value v_msg {
                tc_V2G_EVCC_Msg_Timer.stop;
                var octetstring resp_payload := v_msg.raw;
                // Decode the OCTETSTRING response back to charstring for logging
                var charstring resp_json := oct2char(resp_payload);
                log("SupportedAppProtocolRes received (raw JSON): ", resp_json);
                setverdict(pass, "SupportedAppProtocol exchange completed");
            }
            [] tc_V2G_EVCC_Msg_Timer.timeout {
                setverdict(inconc, "Timeout waiting for SupportedAppProtocolRes");
            }
        }

        return getverdict;
    }
}