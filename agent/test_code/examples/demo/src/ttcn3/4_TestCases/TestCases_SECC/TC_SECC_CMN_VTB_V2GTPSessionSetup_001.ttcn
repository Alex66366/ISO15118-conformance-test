module TC_SECC_CMN_VTB_V2GTPSessionSetup_001 {

    import from SECC_TestSystem all;
    import from SECC_Types all;
    import from SECC_CmnTemplates all;
    import from SECC_Constants all;

    // Aggregator imports
    import from PreConditions_SECC_15118_2 all;
    import from PostConditions_SECC_15118_2 all;

    // Direct imports for all function modules called
    // (required -- TTCN-3 does NOT re-export transitively)
    import from f_SECC_CMN_PR_InitConfiguration_001 all;
    import from f_SECC_CMN_PR_SupportedAppProtocol_001 all;
    import from f_SECC_CMN_TB_VTB_V2GTPSessionSetup_001 all;
    import from f_SECC_CMN_PO_InitialState_001 all;
    import from f_SECC_CMN_PO_ShutdownConfiguration_001 all;

    // ================================================================
    // Test Case: V2GTPSessionSetup GoodCase
    //
    // Message sequence tested: SupportedAppProtocol -> SessionSetup
    //  (this test case verifies the SessionSetup exchange;
    //   SupportedAppProtocol is a precondition)
    //
    // Four-phase test model:
    //   Phase A:  Port mapping + SDP discovery (InitConfiguration)
    //   Phase B:  SupportedAppProtocol exchange (precondition)
    //   Phase C:  SessionSetup exchange (test behavior -- sends SessionSetupReq,
    //             expects SessionSetupRes with OK response)
    //   Phase D:  Postconditions (cleanup -- unmaps ports)
    //
    // SOP for every V2G message:
    //   STEP 1: Lookup exi_payload_library.json
    //   STEP 2: Locate template in SECC_CmnTemplates.ttcn
    //   STEP 3: Send via structured union template
    //   STEP 4: Receive via matching template, set verdict
    //
    // @desc    SessionSetup message exchange test case (GoodCase)
    // @ref     ISO 15118-2 / ISO 15118-4
    // @require V2G-REQ-SESSION-SETUP
    // ================================================================

    testcase TC_SECC_CMN_VTB_V2GTPSessionSetup_001()
        runs on SECCTester system SystemSECC
    {
        var verdicttype preConVerdict;

        // Phase A+B: PreConditions
        //   1. InitConfiguration: map ports + SDP discovery via UDP
        f_SECC_CMN_PR_InitConfiguration_001();

        //   2. SupportedAppProtocol: negotiate protocol with SECC
        preConVerdict := f_SECC_CMN_PR_SupportedAppProtocol_001();

        // Phase C: Test Behavior -- SessionSetup exchange (only if preconditions passed)
        if (preConVerdict == pass) {
            f_SECC_CMN_TB_VTB_V2GTPSessionSetup_001();
        } else {
            setverdict(inconc, "SupportedAppProtocol precondition failed");
        }

        // Phase D: PostConditions (unconditional cleanup)
        f_SECC_CMN_PO_InitialState_001();
        f_SECC_CMN_PO_ShutdownConfiguration_001();
    }
}
