module TC_SECC_CMN_VTB_V2GTPSessionSetup_001 {

    import from SECC_TestSystem all;
    import from SECC_CommonFunctions all;

    testcase TC_SECC_CMN_VTB_V2GTPSessionSetup_001()
    runs on SECCTester system SystemSECC {

        log("Starting test case TC_SECC_CMN_VTB_V2GTPSessionSetup_001");

        map(mtc:pt_V2G_TCP_TLS_Port, system:pt_V2G_TCP_TLS_Port);
        map(mtc:pt_V2G_UDP_SDP_Port, system:pt_V2G_UDP_SDP_Port);

        // Step 1: SDP Discovery - send SDP request via UDP to trigger SECC TCP server
        var octetstring sdp_req := '01FE9000000000021000'O;
        log("Sending SDP request to discover SECC...");
        pt_V2G_UDP_SDP_Port.send(sdp_req);

        // Wait for SDP response or timeout
        timer t_sdp;
        t_sdp.start(5.0);

        alt {
            [] pt_V2G_UDP_SDP_Port.receive {
                t_sdp.stop;
                log("SDP response received");
            }
            [] t_sdp.timeout {
                log("SDP timeout, proceeding with TCP connection anyway...");
            }
        }

        // Step 2: Wait for SECC TCP server to start
        timer t_wait;
        t_wait.start(2.0);
        t_wait.timeout;

        // Step 3: Send V2GTP message with EXI-encoded SupportedAppProtocolReq
        // V2GTP header (8 bytes) + EXI payload (68 bytes) = 76 bytes total
        // Header: 01 (version) FE (inverse) 8001 (EXI_ENCODED) 00000044 (68 bytes payload length)
        // EXI payload: Generated by Exificient codec with namespace urn:iso:15118:2:2010:AppProtocol
        // Contains SupportedAppProtocolReq with ISO 15118-2 and DIN SPEC 70121 protocol entries
        var octetstring v2gtp_sap_req := '01FE8001000000448000EBAB9371D34B9B79D189A98989C1D191D191818999D26B9B3A232B30020000000001B75726E3A64696E3A37303132313A323031323A4D73674465660040000000880'O;
        log("Sending V2GTP SupportedAppProtocolReq to SECC...");
        pt_V2G_TCP_TLS_Port.send(v2gtp_sap_req);

        // Step 4: Wait for SupportedAppProtocolRes from SECC
        timer t_test;
        t_test.start(10.0);

        alt {
            [] pt_V2G_TCP_TLS_Port.receive {
                t_test.stop;
                log("TCP response (SupportedAppProtocolRes) received");
                setverdict(pass, "SupportedAppProtocolRes received from SECC");
            }
            [] t_test.timeout {
                setverdict(inconc, "Test timeout - no response from SECC");
            }
        }

        unmap(mtc:pt_V2G_TCP_TLS_Port, system:pt_V2G_TCP_TLS_Port);
        unmap(mtc:pt_V2G_UDP_SDP_Port, system:pt_V2G_UDP_SDP_Port);
    }

} // end of module
