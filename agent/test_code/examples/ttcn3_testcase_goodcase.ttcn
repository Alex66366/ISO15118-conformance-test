/**
 * @desc    GoodCase testcase example in SIL mode (ISO 15118-4)
 *          Tests that SUT correctly processes V2GTP session setup
 *          with valid header information.
 *
 * Pattern: 4-phase test execution model
 *   Phase A: Initialize (map ports - no PTC in SIL)
 *   Phase B: Precondition (simulate SDP/TCP binding)
 *   Phase C: Test behavior (stimulus + verify response)
 *   Phase D: Postcondition (cleanup - no PTC to stop in SIL)
 */
testcase TC_SECC_CMN_VTB_V2GTPSessionSetup_001()
  runs on SECCTester system SystemSECC
{
  var verdicttype preConVerdict;

  // Phase A+B: Pre Conditions (SIL mode - no PTC, no HAL_61851)
  f_SECC_CMN_PR_InitConfiguration_001();
  preConVerdict := f_SECC_CMN_PR_Binding_001();

  // Phase C: Test behavior
  if (preConVerdict == pass) {
    f_SECC_CMN_TB_VTB_V2GTPSessionSetup_001();
  } else {
    log("PreCondition verdict is not pass");
    setverdict(inconc);
  }

  // Phase D: Post Conditions (unconditional cleanup)
  f_SECC_CMN_PO_InitialState_001();
  f_SECC_CMN_PO_ShutdownConfiguration_001();
}
