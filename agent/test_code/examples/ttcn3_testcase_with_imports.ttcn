/**
 * @desc    GoodCase testcase example with Pre/Post Condition imports
 *          Demonstrates the correct import and call structure for
 *          precondition and postcondition functions.
 *
 * Pattern: 4-phase test execution model
 *   Phase A+B: Pre Conditions (imported and called)
 *   Phase C: Test behavior (defined locally)
 *   Phase D: Post Conditions (imported and called)
 */

module TC_SECC_CMN_VTB_SupportedAppProtocol_001 {

  // === Imports from standard libraries ===
  import from ISO15118_2_DataTypes all;
  import from ISO15118_2_Templates all;
  import from ISO15118_2_Functions all;
  import from ISO15118_2_Components all;
  import from ISO15118_2_PICS all;
  import from ISO15118_2_PIXIT all;
  import from ISO15118_2_Timers all;

  // === Imports from PreConditions and PostConditions (generated by Core Agent) ===
  import from PreConditions_SECC_15118_2 all;
  import from PostConditions_SECC_15118_2 all;

  // === Test Behavior Function ===
  function f_SECC_CMN_TB_VTB_SupportedAppProtocol_001()
    runs on SECCTester
    return verdicttype
  {
    var timer tc_V2G_EVCC_Msg_Timer := floattoint(PIXIT_CMN_Message_Timeout);

    // Send SupportedAppProtocolReq
    tc_V2G_EVCC_Msg_Timer.start(PIXIT_CMN_Message_Timeout);
    pt_V2G_TCP_TLS_Port.send(
      md_CMN_V2GTP_Message_001(
        md_CMN_V2GTP_Header_001('01'O, 'FE'O, '8001'O, omit),
        md_CMN_V2GTP_Payload_001(
          md_CMN_SupportedAppProtocolReq_001()
        )
      )
    );

    // Alt block: expect SupportedAppProtocolRes
    alt {
      [] pt_V2G_TCP_TLS_Port.receive(
        mw_CMN_V2GTP_Message_001(
          mw_CMN_V2GTP_Header_001('01'O, 'FE'O, '8002'O, ?),
          mw_CMN_V2GTP_Payload_001(
            mw_CMN_SupportedAppProtocolRes_001(?)
          )
        )
      ) {
        tc_V2G_EVCC_Msg_Timer.stop;
        setverdict(pass, "SECC responded with SupportedAppProtocolRes");
      }
      [] pt_V2G_TCP_TLS_Port.receive(?) {
        tc_V2G_EVCC_Msg_Timer.stop;
        setverdict(fail, "SECC sent unexpected message");
      }
      [] tc_V2G_EVCC_Msg_Timer.timeout {
        setverdict(inconc, "SECC did not respond within timeout");
      }
    }

    return getverdict;
  }

  // === Testcase ===
  testcase TC_SECC_CMN_VTB_SupportedAppProtocol_001()
    runs on SECCTester system SystemSECC
  {
    var HAL_61851_Listener v_HAL_61851_Listener;
    var verdicttype preConVerdict;

    // -- Phase A+B: Pre Conditions --
    // f_SECC_CMN_PR_InitConfiguration_001: creates PTC, maps ports, initializes variables
    // f_SECC_CMN_PR_SupportedAppProtocol_001: SDP + TCP/TLS + AppProtocol handshake
    f_SECC_CMN_PR_InitConfiguration_001(v_HAL_61851_Listener, SystemSECC);
    preConVerdict := f_SECC_CMN_PR_SupportedAppProtocol_001(v_HAL_61851_Listener);

    // -- Phase C: Test behavior --
    if (preConVerdict == pass) {
      f_SECC_CMN_TB_VTB_SupportedAppProtocol_001();
    } else {
      log("PreCondition verdict is not pass");
      setverdict(inconc);
    }

    // -- Phase D: Post Conditions (unconditional cleanup) --
    // f_SECC_CMN_PO_InitialState_001: unmaps ports, stops PTC
    // f_SECC_CMN_PO_ShutdownConfiguration_001: closes TCP/TLS connection
    f_SECC_CMN_PO_InitialState_001(v_HAL_61851_Listener);
    f_SECC_CMN_PO_ShutdownConfiguration_001(v_HAL_61851_Listener, SystemSECC);
  }
}
