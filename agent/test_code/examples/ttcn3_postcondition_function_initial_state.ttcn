/**
 * @desc    InitialState postcondition function example in SIL mode (ISO 15118-4)
 *          Phase D: Port unmapping (no PTC in SIL mode)
 *
 * Pattern reference: test_code/examples/ttcn3_CANONICAL_testcase.ttcn
 */

module f_SECC_CMN_PO_InitialState_001 {

    import from SECC_TestSystem all;

    // Phase D: Restore initial state (SIL mode)
    function f_SECC_CMN_PO_InitialState_001()
    runs on SECCTester
    {
        // Unmap MTC ports (SIL mode: no PTC to stop)
        unmap(mtc:pt_V2G_TCP_TLS_ALM_SECC_Port, system:pt_V2G_TCP_TLS_ALM_SECC_Port);
        unmap(mtc:pt_V2G_UDP_SDP_Port, system:pt_V2G_UDP_SDP_Port);
        log("SIL mode: MTC ports unmapped");
    }
}
