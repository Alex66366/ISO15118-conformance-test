module f_SECC_CMN_PR_TCP_Connected_001 {
  import from SECC_TestSystem all;
  
  /**
   * @desc Establish TCP connection (SIL simulation)
   */
  function f_SECC_CMN_PR_TCP_Connected_001() 
    runs on SECCTester 
    return verdicttype 
  {
    // Map ports (SIL simulation)
    map(mtc:pt_V2G_TCP_TLS_ALM_SECC_Port, system:pt_V2G_TCP_TLS_ALM_SECC_Port);
    log("TCP connection simulated in SIL mode");
    return pass;
  }
}