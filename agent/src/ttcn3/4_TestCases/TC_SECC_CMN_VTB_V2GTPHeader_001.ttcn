module TC_SECC_CMN_VTB_V2GTPHeader_001 {

    /**
     * @desc Test case for V2GTP header validation (GoodCase)
     * @reference ISO 15118-2
     * @requirement V2G2-082
     */

    import from SECC_TestSystem all;
    import from SECC_Types all;
    import from SECC_CmnTemplates all;
    import from SECC_Constants all;
    import from PreConditions_SECC_15118_2 all;
    import from PostConditions_SECC_15118_2 all;
    import from f_SECC_CMN_PR_InitConfiguration_001 all;
    import from f_SECC_CMN_PO_InitialState_001 all;
    import from f_SECC_CMN_PO_ShutdownConfiguration_001 all;

    function f_SECC_CMN_TB_VTB_V2GTPHeader_001()
        runs on SECCTester
        return verdicttype
    {
        timer tc_V2G_EVCC_Msg_Timer := PX_SECC_CMN_Message_Timeout;

        // CRITICAL: Use a REAL, valid ISO 15118-2 EXI octetstring.
        // Dummy EXI placeholders crash the SECC EXI decoder and cause TCP drops.
        var octetstring exi_payload := '8000EBAB9371D34B9B79D189A98989C1D191D191818999D26B9B3A232B30020000000001B75726E3A64696E3A37303132313A323031323A4D736744656600400000008800'O;
        var integer payload_len := lengthof(exi_payload);
        // V2GTP Header: version=01, inv=FE, payloadType=8001 (V2G app message)
        var octetstring v2gtp_msg := '01'O & 'FE'O & '8001'O & int2oct(payload_len, 4) & exi_payload;

        tc_V2G_EVCC_Msg_Timer.start(PX_SECC_CMN_Message_Timeout);
        pt_V2G_TCP_TLS_ALM_SECC_Port.send(v2gtp_msg);

        var octetstring v_resp;
        alt {
            // Expected: Valid V2GTP-encapsulated response
            [] pt_V2G_TCP_TLS_ALM_SECC_Port.receive(?) -> value v_resp {
                tc_V2G_EVCC_Msg_Timer.stop;
                if (lengthof(v_resp) >= 8
                    and substr(v_resp, 0, 1) == '01'O
                    and substr(v_resp, 1, 1) == 'FE'O) {
                    setverdict(pass, "Valid V2GTP header response received");
                } else {
                    setverdict(fail, "Malformed V2GTP response received");
                }
            }
            // Timeout: No response within expected time
            [] tc_V2G_EVCC_Msg_Timer.timeout {
                setverdict(inconc, "Timeout waiting for V2GTP response");
            }
        }

        return getverdict;
    }

    testcase TC_SECC_CMN_VTB_V2GTPHeader_001()
        runs on SECCTester system SystemSECC
    {
        var verdicttype preConVerdict;

        // Phase A+B: Pre Conditions
        preConVerdict := f_SECC_CMN_PR_InitConfiguration_001();

        // Phase C: Test behavior
        if (preConVerdict == pass) {
            f_SECC_CMN_TB_VTB_V2GTPHeader_001();
        } else {
            log("PreCondition verdict is not pass");
            setverdict(inconc);
        }

        // Phase D: Post Conditions (unconditional cleanup)
        f_SECC_CMN_PO_InitialState_001();
        f_SECC_CMN_PO_ShutdownConfiguration_001();
    }

} // end of module TC_SECC_CMN_VTB_V2GTPHeader_001
