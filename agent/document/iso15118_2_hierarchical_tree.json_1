      {
        "section_number": "8.4.3.1",
        "title": "Overview",
        "content_preview": "\nMessages defined as common messages can be applied to the message sequence in any charging mode defined in ISO 15118. \n",
        "content_length": 120,
        "level": 1,
        "classification": "general",
        "test_importance": "high",
