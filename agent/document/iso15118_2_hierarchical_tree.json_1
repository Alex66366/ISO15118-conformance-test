      {
        "section_number": "8.4.5.3.1",
        "title": "PreChargeReq/Res Handling",
        "content_preview": "\nPre charge is used for adjusting the EVSE output voltage to the EV battery voltage. \n",
        "content_length": 86,
        "level": 1,
        "classification": "functional",
        "test_importance": "high",
        "requirements": [],
        "is_message_def": false,
