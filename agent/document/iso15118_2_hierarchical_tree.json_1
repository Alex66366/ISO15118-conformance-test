      },
      {
        "section_number": "8.4.4.2.3",
        "title": "ChargingStatusRes",
        "content_preview": "\nAfter receiving the ChargingStatusReq from the EVCC, the SECC sends the ChargingStatusRes. In case of a successful Metering Status Request, the response provides the current meter readings from the smart meter installed in the EVSE. In case the reading of the meter failed no meter reading are provided. The failure is indicated by the ResponseCode. \n\n[V2G2-243] Depending on the selected Message Set(s) as defined in subclause 8.6.2, the EVCC and the SECC shall implement the mandatory messages and...",
        "content_length": 3221,
        "level": 1,
        "classification": "functional",
        "test_importance": "high",
        "requirements": [
          "V2G2-243",
          "V2G2-244"
        ],
        "is_message_def": false,
        "message_type": null,
        "fields": [],
        "timing_params": [
