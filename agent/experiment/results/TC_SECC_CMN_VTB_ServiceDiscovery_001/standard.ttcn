);
alt {
[]pt_V2G_TCP_TLS_ALM_SECC_Port.receive(md_CMN_V2G_Message_001(
md_CMN_MessageHeaderType_001(vc-sessionID),
md_CMN.BodyType_001(
md_SECC_CMN_ServiceDiscoveryRes_002(oK,?,vc_chargeService,*)))
-> value v_responseMessage{
tc_V2G_EVCC_Msg_Timer.stop;
vcSupportedEnergyTransferMode := v_responseMessage.body.elementElement.serviceDiscoveryRes.serviceDiscoveryRes和支持edEnergyTransferMode;
vc会选择PaymentOption := v_responseMessage.bodyLEMENT.serviceDiscoveryRes paymentOptionList-paymentOption_list[0];
if(PICS_CMN_CMN_IdentificationMode == pnC) {
if(vc会选择PaymentOption != contract) {
setverdict(v_vct, "Invalid payment option was chosen by the SUT.");
}
else {
if(vc会选择PaymentOption != externalPayment) {
setverdict(v_vct, "Invalid payment option was chosen by the SUT.");
}
} else {
vc服务体系 := v_responseMessage.bodyLEMENT.serviceDiscoveryRes.serviceList;
} else {
a_SECC_TCPConnection_Status_Listener(v_vct, "TCP connection was misleadingly & terminated by the SUT.");
} a_SECC_Unexpected_V2G_Message(v_vct, "Unexpected V2G message was received.", {serviceDiscoveryRes := ?});
[isError()] a_SECC_Unexpected_Message(v_vct, "SupportedAppProtocolRes received, & but V2G_Message was expected.");
] a_SECC_Unexpected_Message_Content(v_vct, "Received ServiceDiscoveryRes message, & but with invalid data content.");
} a_SECC Timeout(v_vct);
}
return get verdict;
}

